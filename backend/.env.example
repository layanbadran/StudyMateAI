# Copy this file to ".env" and fill in your own key. NEVER commit ".env".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Multilingual model: works for English AND Arabic notes (about 470 MB download on first run).
# English-only alternative (smaller, ~90 MB): sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Where ChromaDB keeps its data on disk
CHROMA_DIR=./chroma_data

# Upload limit in megabytes
MAX_UPLOAD_MB=20

# Chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
# Cosine distance cut-off (0 = identical, 2 = opposite). Chunks farther than this are ignored.
# This value is a starting guess: tune it with your own notes.
MAX_DISTANCE=0.85

# Address of the frontend (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
